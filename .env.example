# --- Environnement ---
# Optionnelle : valeur par défaut 'production' si absente (src/config/env.ts).
NODE_ENV=development

# Port d'écoute du serveur. Optionnel : si absent, retombe sur serverOptions.port
# (src/index.ts).
PORT=21465

# --- Sécurité interne ---
# Clé partagée vérifiée sur l'en-tête x-internal-key pour TOUTE requête entrante
# (middleware/internalkey.middleware.ts, appliqué globalement dans src/index.ts).
# Doit être identique à la valeur INTERNAL_KEY configurée côté service appelant.
INTERNAL_KEY=<chaîne aléatoire 32+ caractères, générée par environnement>

# Clé partagée vérifiée sur l'en-tête x-api-key pour les appels backend-à-backend
# (middleware/auth.ts, verifyAccessMiddleware), et sur les endpoints à secretkey
# (controller/miscController.ts, controller/sessionController.ts,
# controller/encryptController.ts) — distincte de INTERNAL_KEY, spécifique à ce
# flux d'authentification service-à-service.
WPP_SECRET_KEY=<chaîne aléatoire 32+ caractères, générée par environnement>

# --- JWT (authentification frontend, util/auth/jwt-helper.ts) ---
ACCESS_SECRET=<chaîne aléatoire 32+ caractères, générée par environnement>
REFRESH_SECRET=<chaîne aléatoire 32+ caractères, générée par environnement>

# Domaine appliqué aux cookies JWT (w-access-token/w-refresh-token) en
# production (util/auth/cookie/setCookie.ts). Sans effet hors production.
# Optionnelle : retombe sur 'localhost' si absente.
COOKIE_DOMAIN=localhost

# --- Webhooks sortants ---
# Signe (HMAC-SHA256) chaque webhook envoyé (util/functions.ts, callWebHook).
# IMPORTANT : doit être strictement identique à la valeur WPP_WEBHOOK_SECRET
# configurée côté récepteur du webhook — une valeur différente des deux côtés
# fait échouer la vérification de signature côté récepteur, qui la rejettera.
WPP_WEBHOOK_SECRET=<chaîne aléatoire 32+ caractères, générée par environnement>

# Adresse à laquelle CE service rappelle apps/bot quand un message WhatsApp
# arrive (config/env.ts, createSessionUtil.ts) — décidée uniquement côté
# serveur, jamais par l'appelant (start-session ignore tout `webhook` fourni
# dans le body). Doit passer par api-gateway et PAS directement par le
# service "bot" : apps/bot exige x-internal-key sur toutes ses routes
# (middleware global), header que seul le proxy /v1/bot d'api-gateway
# injecte. Optionnelle : retombe sur la valeur ci-dessous si absente.
BOT_WEBHOOK_URL=http://api-gateway:8080/v1/bot/whatsapp
